# Dockerfile.phase1 - Dedicated container for Phase 1 (Data Prep & RVQ Tokenization)
# Pure ASCII encoding - PyTorch 2.4.0 CUDA 12.4 + transformers 4.49.0 + qwen-tts 0.1.1

FROM pytorch/pytorch:2.4.0-cuda12.4-cudnn9-runtime

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PIPELINE_ENV=local3090
ENV LC_ALL=C.UTF-8
ENV LANG=C.UTF-8

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    ffmpeg \
    libsndfile1 \
    curl \
    build-essential \
    ca-certificates \
    procps \
    && rm -rf /var/lib/apt/lists/*

ARG USER_ID=1000
ARG GROUP_ID=1000
RUN groupadd -g ${GROUP_ID} appuser && \
    useradd -m -u ${USER_ID} -g appuser -s /bin/bash appuser

RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir \
        qwen-tts==0.1.1 \
        soundfile \
        librosa \
        datasets \
        datacollective \
        pandas \
        pyarrow \
        tqdm \
        huggingface_hub

WORKDIR /workspace

USER appuser

CMD ["python", "run_3090.py", "--phase", "prep", "--smoke"]
