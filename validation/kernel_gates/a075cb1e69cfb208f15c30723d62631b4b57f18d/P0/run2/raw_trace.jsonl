{"audio_duration_ms": 7440.0, "cuda_peak_allocated_bytes": 15302991360, "cuda_peak_reserved_bytes": 15424552960, "e2e_rtf": 0.8606394860200003, "empty_audio": false, "event": "p0_request", "exceptions": [], "generated_cb0_frames": 93, "generated_pcm_samples": 178560, "index": 1, "inf_count": 0, "input_id": "p0-01", "nan_count": 0, "prompt": "Chi è Leonardo da Vinci? Rispondi in una sola breve frase.", "rng_seed": 1235, "speaker_rtf": 0.6387681721725942, "success": true, "talker_time_ms": 4752.435200964101, "text": "Leonardo da Vinci fu un genio poliedrico del Rinascimento, noto per essere un artista, scienziato e inventore.", "think_time_ms": 1646.9925340497866, "total_time_ms": 6403.157775988802, "ttfa_ms": 2088.8374029891565, "v9_time_ms": 2.9893190367147326}
{"audio_duration_ms": 9840.0, "cuda_peak_allocated_bytes": 15310275072, "cuda_peak_reserved_bytes": 15432941568, "e2e_rtf": 0.9412988589350626, "empty_audio": false, "event": "p0_request", "exceptions": [], "generated_cb0_frames": 132, "generated_pcm_samples": 236160, "index": 2, "inf_count": 0, "input_id": "p0-02", "nan_count": 0, "prompt": "Cosa fa la fotosintesi clorofilliana? Rispondi in una sola breve frase.", "rng_seed": 1236, "speaker_rtf": 0.6849099358669634, "success": true, "talker_time_ms": 6739.5137689309195, "text": "La fotosintesi clorofilliana è il processo con cui le piante utilizzano la luce solare per convertire anidride carbonica e acqua in glucosio (zucchero) e ossigeno.", "think_time_ms": 2519.144220976159, "total_time_ms": 9262.380771921016, "ttfa_ms": 2969.2162160063162, "v9_time_ms": 3.039380069822073}
{"audio_duration_ms": 2560.0, "cuda_peak_allocated_bytes": 15294955008, "cuda_peak_reserved_bytes": 15432941568, "e2e_rtf": 1.1785212624999986, "empty_audio": false, "event": "p0_request", "exceptions": [], "generated_cb0_frames": 48, "generated_pcm_samples": 61440, "index": 3, "inf_count": 0, "input_id": "p0-03", "nan_count": 0, "prompt": "Qual è la capitale della Francia? Rispondi in una sola breve frase.", "rng_seed": 1237, "speaker_rtf": 0.9497568937149481, "success": true, "talker_time_ms": 2431.377647910267, "text": "La capitale della Francia è Parigi.", "think_time_ms": 582.0522850845009, "total_time_ms": 3017.0144319999963, "ttfa_ms": 1031.831555068493, "v9_time_ms": 2.9371780110523105}
{"audio_duration_ms": 7760.0, "cuda_peak_allocated_bytes": 15304552960, "cuda_peak_reserved_bytes": 15432941568, "e2e_rtf": 0.8748762247443065, "empty_audio": false, "event": "p0_request", "exceptions": [], "generated_cb0_frames": 98, "generated_pcm_samples": 186240, "index": 4, "inf_count": 0, "input_id": "p0-04", "nan_count": 0, "prompt": "Spiega cos'è l'energia solare in una sola breve frase.", "rng_seed": 1238, "speaker_rtf": 0.6350557588955349, "success": true, "talker_time_ms": 4928.032689029351, "text": "L'energia solare è l'energia derivata dalla luce e dal calore del Sole, utilizzata per produrre elettricità o calore.", "think_time_ms": 1857.3768149362877, "total_time_ms": 6789.039504015818, "ttfa_ms": 2300.849279970862, "v9_time_ms": 2.950249006971717}
{"audio_duration_ms": 6400.0, "cuda_peak_allocated_bytes": 15302172160, "cuda_peak_reserved_bytes": 15432941568, "e2e_rtf": 0.8904720315513259, "empty_audio": false, "event": "p0_request", "exceptions": [], "generated_cb0_frames": 88, "generated_pcm_samples": 153600, "index": 5, "inf_count": 0, "input_id": "p0-05", "nan_count": 0, "prompt": "Perché il cielo appare blu di giorno? Rispondi in una sola breve frase.", "rng_seed": 1239, "speaker_rtf": 0.6879915709214401, "success": true, "talker_time_ms": 4403.146053897217, "text": "Il cielo appare blu di giorno a causa della diffusione della luce solare da parte dell'atmosfera.", "think_time_ms": 1292.2331179725006, "total_time_ms": 5699.021001928486, "ttfa_ms": 1731.8436600035056, "v9_time_ms": 2.94182903598994}
{"audio_duration_ms": 9840.0, "cuda_peak_allocated_bytes": 15308142080, "cuda_peak_reserved_bytes": 15432941568, "e2e_rtf": 0.8485345544702396, "empty_audio": false, "event": "p0_request", "exceptions": [], "generated_cb0_frames": 127, "generated_pcm_samples": 236160, "index": 6, "inf_count": 0, "input_id": "p0-06", "nan_count": 0, "prompt": "Che differenza c'è tra caldo e temperatura? Rispondi in una sola breve frase.", "rng_seed": 1240, "speaker_rtf": 0.6489659655542015, "success": true, "talker_time_ms": 6385.825101053342, "text": "La temperatura è una misura quantitativa della quantità di energia termica di un sistema, mentre il caldo è la sensazione soggettiva di calore percepita.", "think_time_ms": 1960.098915034905, "total_time_ms": 8349.580015987158, "ttfa_ms": 2405.1955370232463, "v9_time_ms": 2.955287927761674}
{"audio_duration_ms": 8240.0, "cuda_peak_allocated_bytes": 15305239040, "cuda_peak_reserved_bytes": 15432941568, "e2e_rtf": 0.8393197745091544, "empty_audio": false, "event": "p0_request", "exceptions": [], "generated_cb0_frames": 103, "generated_pcm_samples": 197760, "index": 7, "inf_count": 0, "input_id": "p0-07", "nan_count": 0, "prompt": "Come funziona una bicicletta? Rispondi in una sola breve frase.", "rng_seed": 1241, "speaker_rtf": 0.6258260112852582, "success": true, "talker_time_ms": 5156.806332990527, "text": "Una bicicletta funziona trasformando l'energia umana in movimento rotatorio tramite la pedalata che aziona la catena e le ruote.", "think_time_ms": 1755.4931390332058, "total_time_ms": 6915.994941955432, "ttfa_ms": 2198.529436951503, "v9_time_ms": 2.981868921779096}
{"audio_duration_ms": 2640.0, "cuda_peak_allocated_bytes": 15295486464, "cuda_peak_reserved_bytes": 15432941568, "e2e_rtf": 1.253893120067942, "empty_audio": false, "event": "p0_request", "exceptions": [], "generated_cb0_frames": 50, "generated_pcm_samples": 63360, "index": 8, "inf_count": 0, "input_id": "p0-08", "nan_count": 0, "prompt": "Qual è il pianeta più vicino al Sole? Rispondi in una sola breve frase.", "rng_seed": 1242, "speaker_rtf": 0.9585259162563351, "success": true, "talker_time_ms": 2530.5084189167246, "text": "Il pianeta più vicino al Sole è Mercurio.", "think_time_ms": 776.1722389841452, "total_time_ms": 3310.277836979367, "ttfa_ms": 1215.2718619909137, "v9_time_ms": 2.92198802344501}
