{"audio_duration_ms": 7440.0, "cuda_peak_allocated_bytes": 15302991360, "cuda_peak_reserved_bytes": 15424552960, "e2e_rtf": 0.8671917443593052, "empty_audio": false, "event": "p0_request", "exceptions": [], "generated_cb0_frames": 93, "generated_pcm_samples": 178560, "index": 1, "inf_count": 0, "input_id": "p0-01", "nan_count": 0, "prompt": "Chi è Leonardo da Vinci? Rispondi in una sola breve frase.", "rng_seed": 1235, "speaker_rtf": 0.6405497041639812, "success": true, "talker_time_ms": 4765.68979898002, "text": "Leonardo da Vinci fu un genio poliedrico del Rinascimento, noto per essere un artista, scienziato e inventore.", "think_time_ms": 1681.750385905616, "total_time_ms": 6451.906578033231, "ttfa_ms": 2130.754742072895, "v9_time_ms": 2.9955190839245915}
{"audio_duration_ms": 9840.0, "cuda_peak_allocated_bytes": 15310275072, "cuda_peak_reserved_bytes": 15432941568, "e2e_rtf": 0.9429259324158595, "empty_audio": false, "event": "p0_request", "exceptions": [], "generated_cb0_frames": 132, "generated_pcm_samples": 236160, "index": 2, "inf_count": 0, "input_id": "p0-02", "nan_count": 0, "prompt": "Cosa fa la fotosintesi clorofilliana? Rispondi in una sola breve frase.", "rng_seed": 1236, "speaker_rtf": 0.685924186375526, "success": true, "talker_time_ms": 6749.493993935175, "text": "La fotosintesi clorofilliana è il processo con cui le piante utilizzano la luce solare per convertire anidride carbonica e acqua in glucosio (zucchero) e ossigeno.", "think_time_ms": 2525.270082987845, "total_time_ms": 9278.391174972057, "ttfa_ms": 2976.246861042455, "v9_time_ms": 2.9721379978582263}
{"audio_duration_ms": 2560.0, "cuda_peak_allocated_bytes": 15294955008, "cuda_peak_reserved_bytes": 15432941568, "e2e_rtf": 1.1791492413976812, "empty_audio": false, "event": "p0_request", "exceptions": [], "generated_cb0_frames": 48, "generated_pcm_samples": 61440, "index": 3, "inf_count": 0, "input_id": "p0-03", "nan_count": 0, "prompt": "Qual è la capitale della Francia? Rispondi in una sola breve frase.", "rng_seed": 1237, "speaker_rtf": 0.9499343887000578, "success": true, "talker_time_ms": 2431.832035072148, "text": "La capitale della Francia è Parigi.", "think_time_ms": 583.2015840569511, "total_time_ms": 3018.622057978064, "ttfa_ms": 1033.443380962126, "v9_time_ms": 2.934797899797559}
{"audio_duration_ms": 7760.0, "cuda_peak_allocated_bytes": 15304552960, "cuda_peak_reserved_bytes": 15432941568, "e2e_rtf": 0.8915893707397998, "empty_audio": false, "event": "p0_request", "exceptions": [], "generated_cb0_frames": 98, "generated_pcm_samples": 186240, "index": 4, "inf_count": 0, "input_id": "p0-04", "nan_count": 0, "prompt": "Spiega cos'è l'energia solare in una sola breve frase.", "rng_seed": 1238, "speaker_rtf": 0.6464201456221473, "success": true, "talker_time_ms": 5016.220330027863, "text": "L'energia solare è l'energia derivata dalla luce e dal calore del Sole, utilizzata per produrre elettricità o calore.", "think_time_ms": 1898.2306269463152, "total_time_ms": 6918.733516940847, "ttfa_ms": 2346.8485169578344, "v9_time_ms": 2.9959389939904213}
{"audio_duration_ms": 6400.0, "cuda_peak_allocated_bytes": 15302172160, "cuda_peak_reserved_bytes": 15432941568, "e2e_rtf": 0.9076086323329946, "empty_audio": false, "event": "p0_request", "exceptions": [], "generated_cb0_frames": 88, "generated_pcm_samples": 153600, "index": 5, "inf_count": 0, "input_id": "p0-05", "nan_count": 0, "prompt": "Perché il cielo appare blu di giorno? Rispondi in una sola breve frase.", "rng_seed": 1239, "speaker_rtf": 0.7002442898374284, "success": true, "talker_time_ms": 4481.563454959542, "text": "Il cielo appare blu di giorno a causa della diffusione della luce solare da parte dell'atmosfera.", "think_time_ms": 1323.4510719776154, "total_time_ms": 5808.6952469311655, "ttfa_ms": 1769.513089908287, "v9_time_ms": 2.9894490726292133}
{"audio_duration_ms": 9840.0, "cuda_peak_allocated_bytes": 15308142080, "cuda_peak_reserved_bytes": 15432941568, "e2e_rtf": 0.8646683117807312, "empty_audio": false, "event": "p0_request", "exceptions": [], "generated_cb0_frames": 127, "generated_pcm_samples": 236160, "index": 6, "inf_count": 0, "input_id": "p0-06", "nan_count": 0, "prompt": "Che differenza c'è tra caldo e temperatura? Rispondi in una sola breve frase.", "rng_seed": 1240, "speaker_rtf": 0.6594130083302422, "success": true, "talker_time_ms": 6488.624001969583, "text": "La temperatura è una misura quantitativa della quantità di energia termica di un sistema, mentre il caldo è la sensazione soggettiva di calore percepita.", "think_time_ms": 2016.0437459126115, "total_time_ms": 8508.336187922396, "ttfa_ms": 2464.5129030104727, "v9_time_ms": 2.989419037476182}
{"audio_duration_ms": 8240.0, "cuda_peak_allocated_bytes": 15305239040, "cuda_peak_reserved_bytes": 15432941568, "e2e_rtf": 0.8550307828875358, "empty_audio": false, "event": "p0_request", "exceptions": [], "generated_cb0_frames": 103, "generated_pcm_samples": 197760, "index": 7, "inf_count": 0, "input_id": "p0-07", "nan_count": 0, "prompt": "Come funziona una bicicletta? Rispondi in una sola breve frase.", "rng_seed": 1241, "speaker_rtf": 0.6364655211196028, "success": true, "talker_time_ms": 5244.475894025527, "text": "Una bicicletta funziona trasformando l'energia umana in movimento rotatorio tramite la pedalata che aziona la catena e le ruote.", "think_time_ms": 1797.3451670259237, "total_time_ms": 7045.453650993295, "ttfa_ms": 2247.687825001776, "v9_time_ms": 2.9620189452543855}
{"audio_duration_ms": 2640.0, "cuda_peak_allocated_bytes": 15295486464, "cuda_peak_reserved_bytes": 15432941568, "e2e_rtf": 1.2754356371288216, "empty_audio": false, "event": "p0_request", "exceptions": [], "generated_cb0_frames": 50, "generated_pcm_samples": 63360, "index": 8, "inf_count": 0, "input_id": "p0-08", "nan_count": 0, "prompt": "Qual è il pianeta più vicino al Sole? Rispondi in una sola breve frase.", "rng_seed": 1242, "speaker_rtf": 0.9737648484808619, "success": true, "talker_time_ms": 2570.7391999894753, "text": "Il pianeta più vicino al Sole è Mercurio.", "think_time_ms": 792.8588829236105, "total_time_ms": 3367.150082020089, "ttfa_ms": 1237.5904599903151, "v9_time_ms": 2.917488105595112}
