{"audio_duration_ms": 7440.0, "cuda_peak_allocated_bytes": 15302991360, "cuda_peak_reserved_bytes": 15424552960, "e2e_rtf": 0.8635266618277397, "empty_audio": false, "event": "p0_request", "exceptions": [], "generated_cb0_frames": 93, "generated_pcm_samples": 178560, "index": 1, "inf_count": 0, "input_id": "p0-01", "nan_count": 0, "prompt": "Chi è Leonardo da Vinci? Rispondi in una sola breve frase.", "rng_seed": 1235, "speaker_rtf": 0.6374176735119764, "success": true, "talker_time_ms": 4742.387490929104, "text": "Leonardo da Vinci fu un genio poliedrico del Rinascimento, noto per essere un artista, scienziato e inventore.", "think_time_ms": 1678.5319519694895, "total_time_ms": 6424.638363998383, "ttfa_ms": 2124.273583991453, "v9_time_ms": 3.009529085829854}
{"audio_duration_ms": 9840.0, "cuda_peak_allocated_bytes": 15310275072, "cuda_peak_reserved_bytes": 15432941568, "e2e_rtf": 0.953357061181914, "empty_audio": false, "event": "p0_request", "exceptions": [], "generated_cb0_frames": 132, "generated_pcm_samples": 236160, "index": 2, "inf_count": 0, "input_id": "p0-02", "nan_count": 0, "prompt": "Cosa fa la fotosintesi clorofilliana? Rispondi in una sola breve frase.", "rng_seed": 1236, "speaker_rtf": 0.6917998635156148, "success": true, "talker_time_ms": 6807.31065699365, "text": "La fotosintesi clorofilliana è il processo con cui le piante utilizzano la luce solare per convertire anidride carbonica e acqua in glucosio (zucchero) e ossigeno.", "think_time_ms": 2569.9664530111477, "total_time_ms": 9381.033482030034, "ttfa_ms": 3023.6606739927083, "v9_time_ms": 3.0326000414788723}
{"audio_duration_ms": 2560.0, "cuda_peak_allocated_bytes": 15294955008, "cuda_peak_reserved_bytes": 15432941568, "e2e_rtf": 1.2064154800555116, "empty_audio": false, "event": "p0_request", "exceptions": [], "generated_cb0_frames": 48, "generated_pcm_samples": 61440, "index": 3, "inf_count": 0, "input_id": "p0-03", "nan_count": 0, "prompt": "Qual è la capitale della Francia? Rispondi in una sola breve frase.", "rng_seed": 1237, "speaker_rtf": 0.9748890171977109, "success": true, "talker_time_ms": 2495.71588402614, "text": "La capitale della Francia è Parigi.", "think_time_ms": 588.9931150013581, "total_time_ms": 3088.4236289421096, "ttfa_ms": 1050.3493389114738, "v9_time_ms": 2.963377977721393}
{"audio_duration_ms": 7760.0, "cuda_peak_allocated_bytes": 15304552960, "cuda_peak_reserved_bytes": 15432941568, "e2e_rtf": 0.8992413543740806, "empty_audio": false, "event": "p0_request", "exceptions": [], "generated_cb0_frames": 98, "generated_pcm_samples": 186240, "index": 4, "inf_count": 0, "input_id": "p0-04", "nan_count": 0, "prompt": "Spiega cos'è l'energia solare in una sola breve frase.", "rng_seed": 1238, "speaker_rtf": 0.6503064076016541, "success": true, "talker_time_ms": 5046.3777229888365, "text": "L'energia solare è l'energia derivata dalla luce e dal calore del Sole, utilizzata per produrre elettricità o calore.", "think_time_ms": 1928.0676569323987, "total_time_ms": 6978.112909942865, "ttfa_ms": 2381.27439992968, "v9_time_ms": 3.0122590251266956}
{"audio_duration_ms": 6400.0, "cuda_peak_allocated_bytes": 15302172160, "cuda_peak_reserved_bytes": 15432941568, "e2e_rtf": 0.9180550482960825, "empty_audio": false, "event": "p0_request", "exceptions": [], "generated_cb0_frames": 88, "generated_pcm_samples": 153600, "index": 5, "inf_count": 0, "input_id": "p0-05", "nan_count": 0, "prompt": "Perché il cielo appare blu di giorno? Rispondi in una sola breve frase.", "rng_seed": 1239, "speaker_rtf": 0.7036362384496897, "success": true, "talker_time_ms": 4503.271926078014, "text": "Il cielo appare blu di giorno a causa della diffusione della luce solare da parte dell'atmosfera.", "think_time_ms": 1368.64262400195, "total_time_ms": 5875.552309094928, "ttfa_ms": 1817.3045730218291, "v9_time_ms": 2.969947992824018}
{"audio_duration_ms": 9840.0, "cuda_peak_allocated_bytes": 15308142080, "cuda_peak_reserved_bytes": 15432941568, "e2e_rtf": 0.8693954242938539, "empty_audio": false, "event": "p0_request", "exceptions": [], "generated_cb0_frames": 127, "generated_pcm_samples": 236160, "index": 6, "inf_count": 0, "input_id": "p0-06", "nan_count": 0, "prompt": "Che differenza c'è tra caldo e temperatura? Rispondi in una sola breve frase.", "rng_seed": 1240, "speaker_rtf": 0.6627359562028177, "success": true, "talker_time_ms": 6521.321809035726, "text": "La temperatura è una misura quantitativa della quantità di energia termica di un sistema, mentre il caldo è la sensazione soggettiva di calore percepita.", "think_time_ms": 2029.8956260085106, "total_time_ms": 8554.850975051522, "ttfa_ms": 2480.3842949913815, "v9_time_ms": 2.9748090310022235}
{"audio_duration_ms": 8240.0, "cuda_peak_allocated_bytes": 15305239040, "cuda_peak_reserved_bytes": 15432941568, "e2e_rtf": 0.851802568437952, "empty_audio": false, "event": "p0_request", "exceptions": [], "generated_cb0_frames": 103, "generated_pcm_samples": 197760, "index": 7, "inf_count": 0, "input_id": "p0-07", "nan_count": 0, "prompt": "Come funziona una bicicletta? Rispondi in una sola breve frase.", "rng_seed": 1241, "speaker_rtf": 0.6323473139505525, "success": true, "talker_time_ms": 5210.541866952553, "text": "Una bicicletta funziona trasformando l'energia umana in movimento rotatorio tramite la pedalata che aziona la catena e le ruote.", "think_time_ms": 1804.632295970805, "total_time_ms": 7018.853163928725, "ttfa_ms": 2252.385300002061, "v9_time_ms": 3.0142400646582246}
{"audio_duration_ms": 2640.0, "cuda_peak_allocated_bytes": 15295486464, "cuda_peak_reserved_bytes": 15432941568, "e2e_rtf": 1.2672515481068385, "empty_audio": false, "event": "p0_request", "exceptions": [], "generated_cb0_frames": 50, "generated_pcm_samples": 63360, "index": 8, "inf_count": 0, "input_id": "p0-08", "nan_count": 0, "prompt": "Qual è il pianeta più vicino al Sole? Rispondi in una sola breve frase.", "rng_seed": 1242, "speaker_rtf": 0.9670315632705971, "success": true, "talker_time_ms": 2552.9633270343766, "text": "Il pianeta più vicino al Sole è Mercurio.", "think_time_ms": 788.9354919316247, "total_time_ms": 3345.544087002054, "ttfa_ms": 1232.1783610386774, "v9_time_ms": 2.9466169653460383}
