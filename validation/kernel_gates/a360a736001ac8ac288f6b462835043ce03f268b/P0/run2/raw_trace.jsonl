{"audio_duration_ms": 7440.0, "cuda_peak_allocated_bytes": 15302991360, "cuda_peak_reserved_bytes": 15424552960, "e2e_rtf": 0.8666090454289099, "empty_audio": false, "event": "p0_request", "exceptions": [], "generated_cb0_frames": 93, "generated_pcm_samples": 178560, "index": 1, "inf_count": 0, "input_id": "p0-01", "nan_count": 0, "prompt": "Chi è Leonardo da Vinci? Rispondi in una sola breve frase.", "rng_seed": 1235, "speaker_rtf": 0.6421305674662744, "success": true, "talker_time_ms": 4777.451421949081, "text": "Leonardo da Vinci fu un genio poliedrico del Rinascimento, noto per essere un artista, scienziato e inventore.", "think_time_ms": 1666.350663988851, "total_time_ms": 6447.5712979910895, "ttfa_ms": 2115.3355680871755, "v9_time_ms": 3.0314300674945116}
{"audio_duration_ms": 9840.0, "cuda_peak_allocated_bytes": 15310275072, "cuda_peak_reserved_bytes": 15432941568, "e2e_rtf": 0.9484908437996163, "empty_audio": false, "event": "p0_request", "exceptions": [], "generated_cb0_frames": 132, "generated_pcm_samples": 236160, "index": 2, "inf_count": 0, "input_id": "p0-02", "nan_count": 0, "prompt": "Cosa fa la fotosintesi clorofilliana? Rispondi in una sola breve frase.", "rng_seed": 1236, "speaker_rtf": 0.6899278991779018, "success": true, "talker_time_ms": 6788.890527910553, "text": "La fotosintesi clorofilliana è il processo con cui le piante utilizzano la luce solare per convertire anidride carbonica e acqua in glucosio (zucchero) e ossigeno.", "think_time_ms": 2540.5776450643316, "total_time_ms": 9333.149902988225, "ttfa_ms": 2992.397535010241, "v9_time_ms": 3.013839013874531}
{"audio_duration_ms": 2560.0, "cuda_peak_allocated_bytes": 15294955008, "cuda_peak_reserved_bytes": 15432941568, "e2e_rtf": 1.190029123063141, "empty_audio": false, "event": "p0_request", "exceptions": [], "generated_cb0_frames": 48, "generated_pcm_samples": 61440, "index": 3, "inf_count": 0, "input_id": "p0-03", "nan_count": 0, "prompt": "Qual è la capitale della Francia? Rispondi in una sola breve frase.", "rng_seed": 1237, "speaker_rtf": 0.9595126453405101, "success": true, "talker_time_ms": 2456.3523720717058, "text": "La capitale della Francia è Parigi.", "think_time_ms": 586.5063340170309, "total_time_ms": 3046.474555041641, "ttfa_ms": 1042.7711160155013, "v9_time_ms": 2.942207967862487}
{"audio_duration_ms": 7760.0, "cuda_peak_allocated_bytes": 15304552960, "cuda_peak_reserved_bytes": 15432941568, "e2e_rtf": 0.8813194271966758, "empty_audio": false, "event": "p0_request", "exceptions": [], "generated_cb0_frames": 98, "generated_pcm_samples": 186240, "index": 4, "inf_count": 0, "input_id": "p0-04", "nan_count": 0, "prompt": "Spiega cos'è l'energia solare in una sola breve frase.", "rng_seed": 1238, "speaker_rtf": 0.6395744466458053, "success": true, "talker_time_ms": 4963.09770597145, "text": "L'energia solare è l'energia derivata dalla luce e dal calore del Sole, utilizzata per produrre elettricità o calore.", "think_time_ms": 1872.285029035993, "total_time_ms": 6839.038755046204, "ttfa_ms": 2318.1943030795082, "v9_time_ms": 3.002639045007527}
{"audio_duration_ms": 6400.0, "cuda_peak_allocated_bytes": 15302172160, "cuda_peak_reserved_bytes": 15432941568, "e2e_rtf": 0.8979770479709259, "empty_audio": false, "event": "p0_request", "exceptions": [], "generated_cb0_frames": 88, "generated_pcm_samples": 153600, "index": 5, "inf_count": 0, "input_id": "p0-05", "nan_count": 0, "prompt": "Perché il cielo appare blu di giorno? Rispondi in una sola breve frase.", "rng_seed": 1239, "speaker_rtf": 0.6937688667312614, "success": true, "talker_time_ms": 4440.120747080073, "text": "Il cielo appare blu di giorno a causa della diffusione della luce solare da parte dell'atmosfera.", "think_time_ms": 1303.2127890037373, "total_time_ms": 5747.053107013926, "ttfa_ms": 1746.393388020806, "v9_time_ms": 3.0226189410313964}
{"audio_duration_ms": 9840.0, "cuda_peak_allocated_bytes": 15308142080, "cuda_peak_reserved_bytes": 15432941568, "e2e_rtf": 0.8617013933968056, "empty_audio": false, "event": "p0_request", "exceptions": [], "generated_cb0_frames": 127, "generated_pcm_samples": 236160, "index": 6, "inf_count": 0, "input_id": "p0-06", "nan_count": 0, "prompt": "Che differenza c'è tra caldo e temperatura? Rispondi in una sola breve frase.", "rng_seed": 1240, "speaker_rtf": 0.6604075768292405, "success": true, "talker_time_ms": 6498.410555999726, "text": "La temperatura è una misura quantitativa della quantità di energia termica di un sistema, mentre il caldo è la sensazione soggettiva di calore percepita.", "think_time_ms": 1976.9822240341455, "total_time_ms": 8479.141711024567, "ttfa_ms": 2422.239316976629, "v9_time_ms": 3.0173090053722262}
{"audio_duration_ms": 8240.0, "cuda_peak_allocated_bytes": 15305239040, "cuda_peak_reserved_bytes": 15432941568, "e2e_rtf": 0.860702860193413, "empty_audio": false, "event": "p0_request", "exceptions": [], "generated_cb0_frames": 103, "generated_pcm_samples": 197760, "index": 7, "inf_count": 0, "input_id": "p0-07", "nan_count": 0, "prompt": "Come funziona una bicicletta? Rispondi in una sola breve frase.", "rng_seed": 1241, "speaker_rtf": 0.6409157132243882, "success": true, "talker_time_ms": 5281.145476968959, "text": "Una bicicletta funziona trasformando l'energia umana in movimento rotatorio tramite la pedalata che aziona la catena e le ruote.", "think_time_ms": 1807.3212200542912, "total_time_ms": 7092.191567993723, "ttfa_ms": 2258.211205014959, "v9_time_ms": 3.0020290287211537}
{"audio_duration_ms": 2640.0, "cuda_peak_allocated_bytes": 15295486464, "cuda_peak_reserved_bytes": 15432941568, "e2e_rtf": 1.2830749575655456, "empty_audio": false, "event": "p0_request", "exceptions": [], "generated_cb0_frames": 50, "generated_pcm_samples": 63360, "index": 8, "inf_count": 0, "input_id": "p0-08", "nan_count": 0, "prompt": "Qual è il pianeta più vicino al Sole? Rispondi in una sola breve frase.", "rng_seed": 1242, "speaker_rtf": 0.9796860723519896, "success": true, "talker_time_ms": 2586.3712310092524, "text": "Il pianeta più vicino al Sole è Mercurio.", "think_time_ms": 797.3594790091738, "total_time_ms": 3387.3178879730403, "ttfa_ms": 1245.3687069937587, "v9_time_ms": 2.9596079839393497}
