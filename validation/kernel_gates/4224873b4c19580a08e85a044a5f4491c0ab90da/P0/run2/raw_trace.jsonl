{"audio_duration_ms": 9840.0, "cuda_peak_allocated_bytes": 15310275072, "cuda_peak_reserved_bytes": 15432941568, "e2e_rtf": 0.9530987754999849, "empty_audio": false, "event": "p0_request", "exceptions": [], "generated_cb0_frames": 132, "generated_pcm_samples": 236160, "index": 2, "inf_count": 0, "input_id": "p0-02", "nan_count": 0, "prompt": "Cosa fa la fotosintesi clorofilliana? Rispondi in una sola breve frase.", "rng_seed": 1236, "speaker_rtf": 0.6918263353660089, "success": true, "talker_time_ms": 6807.571140001528, "text": "La fotosintesi clorofilliana è il processo con cui le piante utilizzano la luce solare per convertire anidride carbonica e acqua in glucosio (zucchero) e ossigeno.", "think_time_ms": 2567.168178036809, "total_time_ms": 9378.491950919852, "ttfa_ms": 3019.6385129820555, "v9_time_ms": 3.0446909368038177}
{"audio_duration_ms": 2560.0, "cuda_peak_allocated_bytes": 15294955008, "cuda_peak_reserved_bytes": 15432941568, "e2e_rtf": 1.2050792050558812, "empty_audio": false, "event": "p0_request", "exceptions": [], "generated_cb0_frames": 48, "generated_pcm_samples": 61440, "index": 3, "inf_count": 0, "input_id": "p0-03", "nan_count": 0, "prompt": "Qual è la capitale della Francia? Rispondi in una sola breve frase.", "rng_seed": 1237, "speaker_rtf": 0.9723859683163028, "success": true, "talker_time_ms": 2489.308078889735, "text": "La capitale della Francia è Parigi.", "think_time_ms": 592.0513059245422, "total_time_ms": 3085.002764943056, "ttfa_ms": 1049.5713730342686, "v9_time_ms": 2.965529100038111}
{"audio_duration_ms": 7760.0, "cuda_peak_allocated_bytes": 15304552960, "cuda_peak_reserved_bytes": 15432941568, "e2e_rtf": 0.898283716761051, "empty_audio": false, "event": "p0_request", "exceptions": [], "generated_cb0_frames": 98, "generated_pcm_samples": 186240, "index": 4, "inf_count": 0, "input_id": "p0-04", "nan_count": 0, "prompt": "Spiega cos'è l'energia solare in una sola breve frase.", "rng_seed": 1238, "speaker_rtf": 0.6500212299084224, "success": true, "talker_time_ms": 5044.164744089358, "text": "L'energia solare è l'energia derivata dalla luce e dal calore del Sole, utilizzata per produrre elettricità o calore.", "think_time_ms": 1922.9205789742991, "total_time_ms": 6970.681642065756, "ttfa_ms": 2373.74995497521, "v9_time_ms": 2.979638986289501}
{"audio_duration_ms": 6400.0, "cuda_peak_allocated_bytes": 15302172160, "cuda_peak_reserved_bytes": 15432941568, "e2e_rtf": 0.9153064457859728, "empty_audio": false, "event": "p0_request", "exceptions": [], "generated_cb0_frames": 88, "generated_pcm_samples": 153600, "index": 5, "inf_count": 0, "input_id": "p0-05", "nan_count": 0, "prompt": "Perché il cielo appare blu di giorno? Rispondi in una sola breve frase.", "rng_seed": 1239, "speaker_rtf": 0.7053951909438183, "success": true, "talker_time_ms": 4514.529222040437, "text": "Il cielo appare blu di giorno a causa della diffusione della luce solare da parte dell'atmosfera.", "think_time_ms": 1339.8209009319544, "total_time_ms": 5857.961253030226, "ttfa_ms": 1788.8894290663302, "v9_time_ms": 2.9634489910677075}
{"audio_duration_ms": 9840.0, "cuda_peak_allocated_bytes": 15308142080, "cuda_peak_reserved_bytes": 15432941568, "e2e_rtf": 0.8683527163556414, "empty_audio": false, "event": "p0_request", "exceptions": [], "generated_cb0_frames": 127, "generated_pcm_samples": 236160, "index": 6, "inf_count": 0, "input_id": "p0-06", "nan_count": 0, "prompt": "Che differenza c'è tra caldo e temperatura? Rispondi in una sola breve frase.", "rng_seed": 1240, "speaker_rtf": 0.661667408026486, "success": true, "talker_time_ms": 6510.807294980623, "text": "La temperatura è una misura quantitativa della quantità di energia termica di un sistema, mentre il caldo è la sensazione soggettiva di calore percepita.", "think_time_ms": 2030.1790749654174, "total_time_ms": 8544.59072893951, "ttfa_ms": 2482.3682439746335, "v9_time_ms": 2.9491790337488055}
{"audio_duration_ms": 8240.0, "cuda_peak_allocated_bytes": 15305239040, "cuda_peak_reserved_bytes": 15432941568, "e2e_rtf": 0.8611090169898551, "empty_audio": false, "event": "p0_request", "exceptions": [], "generated_cb0_frames": 103, "generated_pcm_samples": 197760, "index": 7, "inf_count": 0, "input_id": "p0-07", "nan_count": 0, "prompt": "Come funziona una bicicletta? Rispondi in una sola breve frase.", "rng_seed": 1241, "speaker_rtf": 0.6398411009780547, "success": true, "talker_time_ms": 5272.290672059171, "text": "Una bicicletta funziona trasformando l'energia umana in movimento rotatorio tramite la pedalata che aziona la catena e le ruote.", "think_time_ms": 1819.5288659771904, "total_time_ms": 7095.538299996406, "ttfa_ms": 2271.273138001561, "v9_time_ms": 3.0083799501881003}
