{"audio_duration_ms": 7440.0, "cuda_peak_allocated_bytes": 15302991360, "cuda_peak_reserved_bytes": 15424552960, "e2e_rtf": 0.8618222134436921, "empty_audio": false, "event": "p0_request", "exceptions": [], "generated_cb0_frames": 93, "generated_pcm_samples": 178560, "index": 1, "inf_count": 0, "input_id": "p0-01", "nan_count": 0, "prompt": "Chi è Leonardo da Vinci? Rispondi in una sola breve frase.", "rng_seed": 1235, "speaker_rtf": 0.6356857112898011, "success": true, "talker_time_ms": 4729.50169199612, "text": "Leonardo da Vinci fu un genio poliedrico del Rinascimento, noto per essere un artista, scienziato e inventore.", "think_time_ms": 1678.7012129789218, "total_time_ms": 6411.9572680210695, "ttfa_ms": 2127.0282990299165, "v9_time_ms": 3.059981041587889}
{"audio_duration_ms": 9840.0, "cuda_peak_allocated_bytes": 15310275072, "cuda_peak_reserved_bytes": 15432941568, "e2e_rtf": 0.9445403330241012, "empty_audio": false, "event": "p0_request", "exceptions": [], "generated_cb0_frames": 132, "generated_pcm_samples": 236160, "index": 2, "inf_count": 0, "input_id": "p0-02", "nan_count": 0, "prompt": "Cosa fa la fotosintesi clorofilliana? Rispondi in una sola breve frase.", "rng_seed": 1236, "speaker_rtf": 0.690300296956571, "success": true, "talker_time_ms": 6792.554922052659, "text": "La fotosintesi clorofilliana è il processo con cui le piante utilizzano la luce solare per convertire anidride carbonica e acqua in glucosio (zucchero) e ossigeno.", "think_time_ms": 2497.933211037889, "total_time_ms": 9294.276876957156, "ttfa_ms": 2944.9353659292683, "v9_time_ms": 3.047260921448469}
{"audio_duration_ms": 2560.0, "cuda_peak_allocated_bytes": 15294955008, "cuda_peak_reserved_bytes": 15432941568, "e2e_rtf": 1.1911276460978115, "empty_audio": false, "event": "p0_request", "exceptions": [], "generated_cb0_frames": 48, "generated_pcm_samples": 61440, "index": 3, "inf_count": 0, "input_id": "p0-03", "nan_count": 0, "prompt": "Qual è la capitale della Francia? Rispondi in una sola breve frase.", "rng_seed": 1237, "speaker_rtf": 0.9618151292670518, "success": true, "talker_time_ms": 2462.2467309236526, "text": "La capitale della Francia è Parigi.", "think_time_ms": 583.3177119493484, "total_time_ms": 3049.2867740103975, "ttfa_ms": 1036.828322103247, "v9_time_ms": 3.0244800727814436}
{"audio_duration_ms": 7760.0, "cuda_peak_allocated_bytes": 15304552960, "cuda_peak_reserved_bytes": 15432941568, "e2e_rtf": 0.8803860026954183, "empty_audio": false, "event": "p0_request", "exceptions": [], "generated_cb0_frames": 98, "generated_pcm_samples": 186240, "index": 4, "inf_count": 0, "input_id": "p0-04", "nan_count": 0, "prompt": "Spiega cos'è l'energia solare in una sola breve frase.", "rng_seed": 1238, "speaker_rtf": 0.6366250131455653, "success": true, "talker_time_ms": 4940.210102009587, "text": "L'energia solare è l'energia derivata dalla luce e dal calore del Sole, utilizzata per produrre elettricità o calore.", "think_time_ms": 1887.8151170210913, "total_time_ms": 6831.795380916446, "ttfa_ms": 2335.444210912101, "v9_time_ms": 3.063579904846847}
{"audio_duration_ms": 6400.0, "cuda_peak_allocated_bytes": 15302172160, "cuda_peak_reserved_bytes": 15432941568, "e2e_rtf": 0.9001263131176529, "empty_audio": false, "event": "p0_request", "exceptions": [], "generated_cb0_frames": 88, "generated_pcm_samples": 153600, "index": 5, "inf_count": 0, "input_id": "p0-05", "nan_count": 0, "prompt": "Perché il cielo appare blu di giorno? Rispondi in una sola breve frase.", "rng_seed": 1239, "speaker_rtf": 0.6968694654642604, "success": true, "talker_time_ms": 4459.964578971267, "text": "Il cielo appare blu di giorno a causa della diffusione della luce solare da parte dell'atmosfera.", "think_time_ms": 1297.1341439988464, "total_time_ms": 5760.808403952979, "ttfa_ms": 1737.5123479869217, "v9_time_ms": 2.9701589373871684}
{"audio_duration_ms": 9840.0, "cuda_peak_allocated_bytes": 15308142080, "cuda_peak_reserved_bytes": 15432941568, "e2e_rtf": 0.8629316469508685, "empty_audio": false, "event": "p0_request", "exceptions": [], "generated_cb0_frames": 127, "generated_pcm_samples": 236160, "index": 6, "inf_count": 0, "input_id": "p0-06", "nan_count": 0, "prompt": "Che differenza c'è tra caldo e temperatura? Rispondi in una sola breve frase.", "rng_seed": 1240, "speaker_rtf": 0.6581876684965497, "success": true, "talker_time_ms": 6476.56665800605, "text": "La temperatura è una misura quantitativa della quantità di energia termica di un sistema, mentre il caldo è la sensazione soggettiva di calore percepita.", "think_time_ms": 2011.0246069962159, "total_time_ms": 8491.247405996546, "ttfa_ms": 2458.8045940035954, "v9_time_ms": 2.97253904864192}
{"audio_duration_ms": 8240.0, "cuda_peak_allocated_bytes": 15305239040, "cuda_peak_reserved_bytes": 15432941568, "e2e_rtf": 0.8518792961094556, "empty_audio": false, "event": "p0_request", "exceptions": [], "generated_cb0_frames": 103, "generated_pcm_samples": 197760, "index": 7, "inf_count": 0, "input_id": "p0-07", "nan_count": 0, "prompt": "Come funziona una bicicletta? Rispondi in una sola breve frase.", "rng_seed": 1241, "speaker_rtf": 0.6339292299653431, "success": true, "talker_time_ms": 5223.576854914427, "text": "Una bicicletta funziona trasformando l'energia umana in movimento rotatorio tramite la pedalata che aziona la catena e le ruote.", "think_time_ms": 1792.2994449036196, "total_time_ms": 7019.485399941914, "ttfa_ms": 2240.0717809796333, "v9_time_ms": 2.941969083622098}
{"audio_duration_ms": 2640.0, "cuda_peak_allocated_bytes": 15295486464, "cuda_peak_reserved_bytes": 15432941568, "e2e_rtf": 1.2727743227239416, "empty_audio": false, "event": "p0_request", "exceptions": [], "generated_cb0_frames": 50, "generated_pcm_samples": 63360, "index": 8, "inf_count": 0, "input_id": "p0-08", "nan_count": 0, "prompt": "Qual è il pianeta più vicino al Sole? Rispondi in una sola breve frase.", "rng_seed": 1242, "speaker_rtf": 0.9700093272840604, "success": true, "talker_time_ms": 2560.8246240299195, "text": "Il pianeta più vicino al Sole è Mercurio.", "think_time_ms": 795.7476599840447, "total_time_ms": 3360.124211991206, "ttfa_ms": 1239.252374973148, "v9_time_ms": 2.91748798917979}
