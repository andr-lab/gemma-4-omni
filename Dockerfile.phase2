# Dockerfile.phase2 - Dedicated container for Phase 2 (Gemma 4 QLoRA, FitNets, Eval, Serving)
# Pure ASCII encoding - PyTorch 2.4.0 CUDA 12.4 + Unsloth + Transformers

FROM pytorch/pytorch:2.4.0-cuda12.4-cudnn9-runtime

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PIPELINE_ENV=local3090
ENV LC_ALL=C.UTF-8
ENV LANG=C.UTF-8

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    ffmpeg \
    libsndfile1 \
    curl \
    build-essential \
    ca-certificates \
    procps \
    && rm -rf /var/lib/apt/lists/*

ARG USER_ID=1000
ARG GROUP_ID=1000
RUN groupadd -g ${GROUP_ID} appuser && \
    useradd -m -u ${USER_ID} -g appuser -s /bin/bash appuser

RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir torch==2.12.1 torchvision==0.27.1 && \
    pip install --no-cache-dir \
        transformers==5.5.0 \
        git+https://github.com/unslothai/unsloth.git \
        git+https://github.com/unslothai/unsloth-zoo.git \
        accelerate \
        bitsandbytes \
        peft \
        trl \
        fastapi \
        uvicorn \
        python-multipart \
        soundfile \
        pandas \
        pyarrow \
        datasets \
        tqdm \
        huggingface_hub

WORKDIR /workspace

USER appuser

CMD ["python", "run_3090.py", "--phase", "train", "--smoke"]
